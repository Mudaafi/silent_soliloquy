{
  "name": "silent_soliloquy",
  "version": "1.0.0",
  "description": "My Conscience",
  "main": "index.js",
  "scripts": {
    "build": "run-p type-check build-only",
    "serve": "run-p serve-fn dev",
    "serve-fn": "npx --yes netlify-cli@27 functions:serve --port 9000",
    "type-check": "run-p type-check:app type-check:fn",
    "type-check:app": "vue-tsc --noEmit -p tsconfig.app.json",
    "type-check:fn": "tsc --noEmit -p tsconfig.functions.json",
    "lint": "eslint --ext .ts,.js,.vue .",
    "build-only": "vite build",
    "dev": "vite",
    "netlify:login": "npx --yes netlify-cli@27 login",
    "netlify:logout": "npx --yes netlify-cli@27 logout"

  },
  "dependencies": {
    "@netlify/functions": "^1.0.0",
    "axios": "^0.27.2",
    "encoding": "^0.1.13",
    "firebase": "^9.9.3",
    "firebase-admin": "^11.0.1",
    "googleapis": "^73.0.0",
    "pinia": "^2.0.17",
    "pinia-plugin-persistedstate": "^2.1.1",
    "telegram-interface": "^0.1.9",
    "uuid": "^8.3.2",
    "vue": "^3.2.37",
    "vue-router": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^16.11.47",
    "@types/uuid": "^8.3.4",
    "@typescript-eslint/eslint-plugin": "^4.22.0",
    "@typescript-eslint/parser": "^4.22.0",
    "@vitejs/plugin-vue": "^3.0.1",
    "@vue/tsconfig": "^0.1.3",
    "eslint": "^7.25.0",
    "eslint-config-prettier": "^8.10.2",
    "eslint-plugin-prettier": "^3.4.0",
    "eslint-plugin-vue": "^9.33.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.2.1",
    "typescript": "^4.8.2",
    "vite": "^3.0.4",
    "vue-tsc": "^0.39.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mudaafi/silent_soliloquy.git"
  },
  "keywords": [
    "netlify",
    "telegram",
    "Google",
    "Sheets",
    "Google",
    "Forms"
  ],
  "author": "Ahmad Mudaafi' <SleepyUndergrad@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Mudaafi/silent_soliloquy/issues"
  },
  "homepage": "https://github.com/Mudaafi/silent_soliloquy#readme"
}
